{
  "name": "potentiamod-editor",
  "version": "1.2.4",
  "private": "true",
  "description": "PotentiaMod editor mono-repository",
  "keywords": [],
  "homepage": "https://github.com/scratchfoundation/scratch-editor#readme",
  "bugs": {
    "url": "https://github.com/scratchfoundation/scratch-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scratchfoundation/scratch-editor.git"
  },
  "author": "Scratch Foundation",
  "workspaces": [
    "packages/scratch-blocks",
    "packages/scratch-paint",
    "packages/scratch-vm",
    "packages/scratch-gui"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production npm run --workspaces build",
    "install": "npm run --workspaces install --legacy-peer-deps",
	"uninstall": "rm -rf node_modules npm-lock.yaml",
    "reinstall": "rm -rf node_modules npm-lock.yaml && npm run --workspaces install --legacy-peer-deps",
    "clean": "npm run --workspaces clean",
    "start": "npm --workspace scratch-gui start"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "conventional-changelog-angular": "8.3.1",
    "cross-env": "7.0.3",
    "globals": "16.5.0",
    "npm": "10.9.9",
    "semantic-release": "25.0.9",
    "ts-node": "10.9.2"
  }
}
